{
 "region": [
  1060,
  40,
  860,
  740
 ],
 "scale": 2,
 "fps": 20,
 "dataDir": ".build/demo-data/queue",
 "background": [
  "#000000",
  "#000000",
  "#000000"
 ],
 "steps": [
  {
   "delay": 0.8,
   "url": "omochi://folder?agent=1&path=~/omochi-demo"
  },
  {
   "delay": 0.1,
   "url": "omochi://folder?agent=2&path=~/omochi-demo"
  },
  {
   "delay": 1.0,
   "mark": "type",
   "url": "omochi://type?agent=1&cps=14&text=1%E3%80%9C50%20%E3%81%AE%E7%B4%A0%E6%95%B0%E3%82%92%20Python%20%E3%81%A7%E6%B1%82%E3%82%81%E3%81%A6%E3%80%81%E8%A1%A8%E3%81%AB%E3%81%97%E3%81%A6"
  },
  {
   "wait": {
    "agent": 1,
    "state": [
     "thinking",
     "working"
    ]
   },
   "timeout": 30,
   "mark": "submitted"
  },
  {
   "delay": 0.5,
   "mark": "q1",
   "url": "omochi://type?agent=1&cps=16&text=%E3%81%9D%E3%81%AE%E7%B4%A0%E6%95%B0%E3%82%92%E5%85%A8%E9%83%A8%E8%B6%B3%E3%81%99%E3%81%A8%EF%BC%9F"
  },
  {
   "delay": 2.0,
   "mark": "q2",
   "url": "omochi://type?agent=1&cps=16&text=%E3%81%9D%E3%81%AE%E5%90%88%E8%A8%88%E3%82%92%E8%8B%B1%E8%AA%9E%E3%81%AE%E3%81%A4%E3%81%A5%E3%82%8A%E3%81%A7%E6%9B%B8%E3%81%84%E3%81%A6"
  },
  {
   "delay": 1.9,
   "mark": "retarget",
   "url": "omochi://queue?agent=1&do=target&index=last&to=2"
  },
  {
   "wait": {
    "agent": 2,
    "state": [
     "thinking",
     "working"
    ]
   },
   "timeout": 90,
   "mark": "mio"
  },
  {
   "wait": {
    "agent": 2,
    "state": [
     "completed",
     "error",
     "cancelled"
    ]
   },
   "timeout": 120,
   "mark": "done"
  },
  {
   "delay": 1.6,
   "mark": "close1",
   "url": "omochi://window?agent=1&do=close"
  },
  {
   "delay": 0.4,
   "mark": "open2",
   "url": "omochi://open?agent=2"
  },
  {
   "delay": 4.5,
   "mark": "end",
   "stop": true
  }
 ]
}
